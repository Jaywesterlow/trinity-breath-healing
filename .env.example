# PUBLIC_SITE_URL is required — set per environment in Vercel dashboard.
# No localhost default: if unset, the build fails loudly (FND-07).
# Local dev: copy this file to .env and set the value explicitly.
PUBLIC_SITE_URL=

# --- Contact form (server-only; set in the Vercel dashboard, never committed) ---
# Resend API key. Unset = the form stays up but answers "mail me directly" instead
# of silently failing. Configure the sending domain in Resend's EU region.
RESEND_API_KEY=
# Verified sender on that domain, e.g. "Trinity Breath & Healing <contact@trinitybnh.nl>"
CONTACT_FROM_EMAIL=
# Inbox that receives submissions. Defaults to BRAND.email when unset.
CONTACT_TO_EMAIL=

# The date planner posts to /api/booking and mails through the same Resend
# setup as the contact form — there is no third-party booking service to
# configure. Availability lives in src/lib/booking/schedule.ts until the CMS
# takes it over.
# Optional override for the per-IP submit throttle (default 5 per 10 minutes).
# The integration suite sets it high; production should leave it unset.
CONTACT_RATE_LIMIT_MAX=
